{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaudesk-api",
  "account_id": "73e742603a81fe41a946b73b9bffdee2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://mwfueezxkbecoismqngn.supabase.co",
    "ALLOWED_ORIGINS": "https://beaudesk.web.app,https://beaudesk.firebaseapp.com,https://beaudesk-admin.web.app,https://beaudesk-admin.firebaseapp.com,https://beaudeskdemo.web.app,https://beaudeskdemo.firebaseapp.com,http://localhost:5180"
  }
  // Secrets (set with `wrangler secret put <NAME>`, never commit):
  //   SUPABASE_SECRET_KEY
  //   WHATSAPP_TOKEN            Meta WhatsApp Cloud API access token
  //   WHATSAPP_PHONE_NUMBER_ID  sender phone number id from Meta
  //   WHATSAPP_TEMPLATE         (optional) approved template name for the token message
  //   WHATSAPP_RECEIPT_TEMPLATE (optional) approved template name for the payment receipt message
  // Without the WhatsApp secrets, /notify/booking answers { status: "demo" } and sends nothing.
}
