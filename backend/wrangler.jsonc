{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaudesk-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://mwfueezxkbecoismqngn.supabase.co",
    "ALLOWED_ORIGINS": "https://beaudeskdemo.web.app,https://beaudeskdemo.firebaseapp.com,http://localhost:5180"
  }
  // Secrets (set with `wrangler secret put <NAME>`, never commit):
  //   SUPABASE_SECRET_KEY
}
